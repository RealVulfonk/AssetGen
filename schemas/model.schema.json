{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["name", "parts"],
  "additionalProperties": false,
  "properties": {
    "name": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "category": {"type": "string", "pattern": "^[a-z0-9_/-]+$"},
    "seed": {"type": "integer"},
    "pivot": {
      "oneOf": [
        {"enum": ["bottom_center", "center", "hinge_left"]},
        {"$ref": "#/$defs/vector3"}
      ]
    },
    "tri_budget": {"type": "integer", "minimum": 1},
    "expected_size": {"$ref": "#/$defs/vector3"},
    "collision": {"enum": ["none", "box", "mesh", "convex"]},
    "materials": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/color"}
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/part"}
    }
  },
  "$defs": {
    "color": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"},
    "vector3": {
      "type": "array",
      "items": {"type": "number"},
      "minItems": 3,
      "maxItems": 3
    },
    "pair": {
      "type": "array",
      "items": {"type": "number"},
      "minItems": 2,
      "maxItems": 2
    },
    "cutout": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "location": {"$ref": "#/$defs/vector3"},
        "rotation": {"$ref": "#/$defs/vector3"}
      },
      "oneOf": [
        {
          "required": ["size"],
          "properties": {
            "type": {"const": "box"},
            "size": {"$ref": "#/$defs/part/properties/size"}
          }
        },
        {
          "required": ["radius", "height"],
          "properties": {
            "type": {"const": "cylinder"},
            "radius": {"$ref": "#/$defs/part/properties/radius"},
            "radius_top": {"$ref": "#/$defs/part/properties/radius"},
            "height": {"$ref": "#/$defs/part/properties/height"},
            "segments": {"$ref": "#/$defs/part/properties/segments"}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "part": {
      "type": "object",
      "required": ["type", "material"],
      "additionalProperties": false,
      "properties": {
        "type": {"enum": ["box", "cylinder", "sphere", "lathe", "extrude", "plane"]},
        "material": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "comment": {"type": "string"},
        "size": {
          "type": "array",
          "items": {"type": "number", "exclusiveMinimum": 0},
          "minItems": 3,
          "maxItems": 3
        },
        "radius": {"type": "number", "exclusiveMinimum": 0},
        "radius_top": {"type": "number", "minimum": 0},
        "height": {"type": "number", "exclusiveMinimum": 0},
        "segments": {"type": "integer", "minimum": 3, "maximum": 24},
        "rings": {"type": "integer", "minimum": 2, "maximum": 16},
        "profile": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "array",
            "prefixItems": [
              {"type": "number", "minimum": 0},
              {"type": "number"}
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          }
        },
        "points": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/pair"}},
        "depth": {"type": "number", "exclusiveMinimum": 0},
        "location": {"$ref": "#/$defs/vector3"},
        "rotation": {"$ref": "#/$defs/vector3"},
        "scale": {"$ref": "#/$defs/vector3"},
        "bevel": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "width": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.1},
            "segments": {"type": "integer", "minimum": 1, "maximum": 4}
          }
        },
        "jitter": {"type": "number", "minimum": 0, "maximum": 0.05},
        "array": {
          "type": "object",
          "required": ["count", "offset"],
          "additionalProperties": false,
          "properties": {
            "count": {"type": "integer", "minimum": 1, "maximum": 1000},
            "offset": {"$ref": "#/$defs/vector3"}
          }
        },
        "mirror_x": {"type": "boolean"},
        "uv_projection": {"const": "cylindrical"},
        "cutouts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {"$ref": "#/$defs/cutout"}
        }
      },
      "allOf": [
        {
          "if": {"required": ["uv_projection"]},
          "then": {"properties": {"type": {"const": "lathe"}}, "not": {"required": ["cutouts"]}}
        },
        {
          "if": {"properties": {"type": {"const": "box"}}},
          "then": {"required": ["size"]}
        },
        {
          "if": {"properties": {"type": {"const": "cylinder"}}},
          "then": {"required": ["radius", "height"]}
        },
        {
          "if": {"properties": {"type": {"const": "sphere"}}},
          "then": {"required": ["radius"]}
        },
        {
          "if": {"properties": {"type": {"const": "lathe"}}},
          "then": {"required": ["profile"]}
        },
        {
          "if": {"properties": {"type": {"const": "extrude"}}},
          "then": {"required": ["points", "depth"]}
        },
        {
          "if": {"properties": {"type": {"const": "plane"}}},
          "then": {
            "required": ["points"],
            "not": {"anyOf": [{"required": ["depth"]}, {"required": ["cutouts"]}, {"required": ["bevel"]}]}
          }
        }
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["asset", "materials"],
  "additionalProperties": false,
  "properties": {
    "asset": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "size": {"type": "integer", "enum": [64, 128, 256, 512], "default": 128},
    "seed": {"type": "integer", "default": 1},
    "pixel": {"type": "boolean", "default": false},
    "quantize": {"type": "boolean", "default": false},
    "samples": {"type": "integer", "minimum": 1, "maximum": 1024, "default": 64},
    "pack_uv": {"type": "boolean", "default": false},
    "margin": {"type": "integer", "minimum": 0, "maximum": 64, "default": 4},
    "materials": {
      "type": "object",
      "required": ["default"],
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/material"}
    }
  },
  "allOf": [{
    "if": {"properties": {"quantize": {"const": true}}, "required": ["quantize"]},
    "then": {"properties": {"materials": {"additionalProperties": {
      "properties": {"source_mode": {"not": {"const": "image"}}}
    }}}}
  }],
  "$defs": {
    "palette": {
      "oneOf": [
        {"type": "string"},
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"}
        }
      ]
    },
    "weight": {"type": "number", "exclusiveMinimum": 0, "default": 1},
    "scale": {"type": "number", "exclusiveMinimum": 0, "default": 5},
    "material_common": {
      "type": "object",
      "required": ["palette"],
      "allOf": [
        {
          "if": {"properties": {"source_mode": {"enum": ["image", "mixed"]}}, "required": ["source_mode"]},
          "then": {"required": ["source_detail"]}
        },
        {
          "if": {"required": ["pbr_detail"]},
          "then": {
            "required": ["source_mode"],
            "properties": {"source_mode": {"const": "image"}}
          }
        }
      ],
      "properties": {
        "source_mode": {"enum": ["procedural", "image", "mixed"]},
        "palette": {"$ref": "#/$defs/palette"},
        "gradient": {"enum": ["constant", "linear", "ease"], "default": "ease"},
        "contrast": {"type": "number", "minimum": 0, "maximum": 4, "default": 1},
        "contrast_pivot": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.5},
        "brightness": {"type": "number", "minimum": -1, "maximum": 1, "default": 0},
        "ao": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.25},
        "ao_distance": {"type": "number", "exclusiveMinimum": 0, "default": 0.15},
        "edge": {"type": "number", "minimum": 0, "maximum": 2, "default": 0},
        "metallic": {"type": "number", "minimum": 0, "maximum": 1, "default": 0},
        "opacity": {"type": "number", "minimum": 0, "maximum": 1, "default": 1},
        "roughness": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.9},
        "source_detail": {
          "type": "object",
          "required": ["image", "tile_size", "strength"],
          "additionalProperties": false,
          "properties": {
            "image": {"type": "string", "pattern": "^[a-z0-9_]+\\.(png|jpe?g)$"},
            "tile_size": {"type": "number", "exclusiveMinimum": 0},
            "strength": {"type": "number", "minimum": 0, "maximum": 1}
          }
        },
        "pbr_detail": {
          "type": "object",
          "required": ["normal", "roughness"],
          "additionalProperties": false,
          "properties": {
            "normal": {"type": "string", "pattern": "^[a-z0-9_]+\\.png$"},
            "roughness": {"type": "string", "pattern": "^[a-z0-9_]+\\.png$"},
            "normal_strength": {"type": "number", "minimum": 0, "maximum": 2, "default": 1}
          }
        }
      }
    },
    "material": {
      "oneOf": [
        {
          "type": "object",
          "allOf": [{"$ref": "#/$defs/material_common"}],
          "properties": {
            "preset": {"enum": ["noise", "wood", "stone", "flat", "metal", "bone", "cloth"], "default": "noise"},
            "scale": {"$ref": "#/$defs/scale"},
            "direction": {"enum": ["X", "Y", "Z"], "default": "X"},
            "distortion": {"type": "number", "minimum": 0, "default": 4},
            "detail": {"type": "number", "minimum": 0, "maximum": 16, "default": 2},
            "value": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.6}
          },
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "allOf": [{"$ref": "#/$defs/material_common"}],
          "required": ["preset"],
          "properties": {
            "preset": {"const": "coopered_wood"},
            "staves": {"type": "integer", "minimum": 3, "maximum": 32, "default": 10},
            "seam_width": {"type": "number", "minimum": 0.01, "maximum": 0.2, "default": 0.06},
            "lid_board_width": {"type": "number", "minimum": 0.01, "maximum": 1, "default": 0.12},
            "grain_strength": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.55}
          },
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "allOf": [{"$ref": "#/$defs/material_common"}],
          "required": ["layers"],
          "properties": {
            "layers": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {"$ref": "#/$defs/layer"}
            }
          },
          "unevaluatedProperties": false
        }
      ]
    },
    "layer": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": {"const": "noise"},
            "weight": {"$ref": "#/$defs/weight"},
            "invert": {"type": "boolean", "default": false},
            "scale": {"$ref": "#/$defs/scale"},
            "detail": {"type": "number", "minimum": 0, "maximum": 16, "default": 2}
          }
        },
        {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": {"const": "wave"},
            "weight": {"$ref": "#/$defs/weight"},
            "invert": {"type": "boolean", "default": false},
            "scale": {"$ref": "#/$defs/scale"},
            "direction": {"enum": ["X", "Y", "Z"], "default": "X"},
            "distortion": {"type": "number", "minimum": 0, "default": 4}
          }
        },
        {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": {"const": "voronoi"},
            "weight": {"$ref": "#/$defs/weight"},
            "invert": {"type": "boolean", "default": false},
            "scale": {"$ref": "#/$defs/scale"}
          }
        },
        {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": {"const": "constant"},
            "weight": {"$ref": "#/$defs/weight"},
            "invert": {"type": "boolean", "default": false},
            "value": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.6}
          }
        }
      ]
    }
  }
}

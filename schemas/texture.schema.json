{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["asset", "materials"],
  "additionalProperties": false,
  "properties": {
    "asset": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "size": {"type": "integer", "enum": [64, 128, 256, 512]},
    "seed": {"type": "integer"},
    "pixel": {"type": "boolean"},
    "quantize": {"type": "boolean"},
    "samples": {"type": "integer", "minimum": 1, "maximum": 1024},
    "margin": {"type": "integer", "minimum": 0, "maximum": 64},
    "materials": {
      "type": "object",
      "required": ["default"],
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/material"}
    }
  },
  "$defs": {
    "material": {
      "type": "object",
      "required": ["palette"],
      "additionalProperties": false,
      "properties": {
        "preset": {"enum": ["noise", "wood", "stone", "flat", "metal", "bone", "cloth"]},
        "palette": {
          "oneOf": [
            {"type": "string"},
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"}
            }
          ]
        },
        "scale": {"type": "number", "exclusiveMinimum": 0},
        "direction": {"enum": ["X", "Y", "Z"]},
        "distortion": {"type": "number", "minimum": 0},
        "detail": {"type": "number", "minimum": 0, "maximum": 16},
        "value": {"type": "number", "minimum": 0, "maximum": 1},
        "contrast": {"type": "number", "minimum": 0, "maximum": 4},
        "brightness": {"type": "number", "minimum": -1, "maximum": 1},
        "ao": {"type": "number", "minimum": 0, "maximum": 1},
        "ao_distance": {"type": "number", "exclusiveMinimum": 0},
        "edge": {"type": "number", "minimum": 0, "maximum": 2},
        "metallic": {"type": "number", "minimum": 0, "maximum": 1},
        "roughness": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
